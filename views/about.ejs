<%- include('partials/header') %>
<div class="wrap about">
  <section>
    <div class="eyebrow">ABOUT IT PARADISE</div>
    <h1 class="h1">Trusted since 2006</h1>
    <% (s.about_text || '').split(/\n\n+/).forEach(par => { %><p class="lead"><%= par %></p><% }) %>
    <div class="nums"><div><small>Since</small><b><%= s.stat_years || '2006' %></b></div><div><small>Installations</small><b><%= s.stat_installs || '5,000+' %></b></div><div><small>Sectors</small><b><%= s.stat_sectors || '6' %></b></div></div>
    <div class="values"><div><%- icon('chat', 20) %><b>Understand.</b><span>We start with your need, not a product list.</span></div><div><%- icon('tool', 20) %><b>Integrate.</b><span>Solutions, not just boxes — one connected ecosystem.</span></div><div><%- icon('headset', 20) %><b>Support.</b><span>One point of contact to keep systems working.</span></div></div>
    <h3 class="h3 mt">Brands we work with</h3>
    <div class="brand-grid"><% brands.forEach(b => { %><div class="brand"><% if (b.logo_id) { %><img src="/media/<%= b.logo_id %>" alt="<%= b.name %>"><% } else { %><%= b.name %><% } %></div><% }) %></div>
  </section>
  <aside class="contact card" id="contact">
    <% const rows = [['Sales', s.phone_sales, 'tel:' + s.phone_sales, 'phone'], ['WhatsApp', s.phone_whatsapp || s.phone_sales, 'https://wa.me/' + waNum, 'wa'], ['Service desk', s.phone_service || s.phone_sales, 'tel:' + (s.phone_service || s.phone_sales), 'headset'], ['Email', s.email, 'mailto:' + s.email, 'mail'], ['Showroom', s.address || s.city, null, 'pin'], ['Timings', s.timings, null, 'clock']]; %>
    <% rows.forEach(([l, v, href, ic]) => { if (!v) return; %><div class="crow"><span class="cic"><%- icon(ic, 18) %></span><div><small><%= l %></small><% if (href) { %><a href="<%= href %>"><%= v %></a><% } else { %><b><%= v %></b><% } %></div></div><% }) %>
    <iframe class="map" title="Map" loading="lazy" src="https://www.google.com/maps?q=<%= encodeURIComponent(s.map_query || 'IT Paradise Bhilwara') %>&output=embed"></iframe>
    <form class="qform" data-api="/api/public/enquiry"><input type="hidden" name="form" value="Contact page"><input type="text" name="website" class="hp" tabindex="-1" autocomplete="off">
      <div class="g2"><label>Name<input name="name" required></label><label>Mobile<input name="mobile" required inputmode="tel"></label></div>
      <label>Message<input name="message" placeholder="How can we help?"></label><button class="btn btn-primary btn-block">Contact our team</button><p class="merr" hidden></p></form>
  </aside>
</div>
<%- include('partials/footer') %>
