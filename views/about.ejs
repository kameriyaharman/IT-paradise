<%- include('partials/header') %>
<section class="page-hero"><div class="wrap">
  <nav class="crumbs"><a href="/">Home</a> <%- icon('right', 12) %> <span>About Us</span></nav>
  <div class="eyebrow">ABOUT IT PARADISE</div>
  <h1 class="h1">Trusted Since <%= s.stat_years || '2006' %></h1>
  <p class="lead"><%= s.tagline || 'Technology, integrated.' %> — one partner for computing, security, networking, power and display in <%= s.city || 'Bhilwara, Rajasthan' %>.</p>
</div></section>
<div class="wrap about2">
  <div class="about-story">
    <% (s.about_text || '').split(/\n\n+/).forEach(par => { %><p class="lead"><%= par %></p><% }) %>
  </div>
  <div class="nums"><div><small>Serving since</small><b><%= s.stat_years || '2006' %></b></div><div><small>Installations</small><b><%= s.stat_installs || '5,000+' %></b></div><div><small>Products</small><b><%= s.stat_products || '400+' %></b></div><div><small>Sectors served</small><b><%= s.stat_sectors || '6' %></b></div></div>
  <h2 class="h2 center mt">Understand. Integrate. Support.</h2>
  <div class="values"><div><%- icon('chat', 22) %><b>Understand</b><span>We start with your need, not a product list — a site visit and honest advice.</span></div><div><%- icon('tool', 22) %><b>Integrate</b><span>Solutions, not just boxes — computing, security and networking planned as one ecosystem.</span></div><div><%- icon('headset', 22) %><b>Support</b><span>One point of contact, own technicians, AMC and quick service.</span></div></div>
  <h2 class="h2 center mt">Industries We Serve</h2>
  <div class="sectors"><% sectors.forEach(x => { %><a href="/solutions/<%= x.slug %>" class="sector"><span class="sic"><%- icon(x.icon, 26) %></span><b><%= x.name %></b><small>See Solution <%- icon('arrow', 12) %></small></a><% }) %></div>
  <% if (brands.length) { %><h2 class="h2 center mt">Brands We Work With</h2>
  <div class="brand-grid big"><% brands.forEach(b => { %><div class="brand"><% if (b.logo_id) { %><img src="/media/<%= b.logo_id %>" alt="<%= b.name %>"><% } else { %><%= b.name %><% } %></div><% }) %></div><% } %>
  <div class="cta-band card"><div><h3>Let’s build what’s next</h3><p class="muted">Your next project starts with a conversation.</p></div><div class="row-btns"><a href="/contact" class="btn btn-primary"><%- icon('phone', 16) %> Contact Us</a><a href="#" class="btn btn-outline" data-open="enquiry" data-need="1" data-form="About page CTA"><%- icon('quote', 16) %> Get a Quote</a></div></div>
</div>
<%- include('partials/footer') %>
