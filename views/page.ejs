<%- include('partials/header') %>
<div class="wrap sec-sm prose">
  <h1 class="h1"><%= page.title %></h1>
  <% (page.body || '').split(/\n\n+/).filter(Boolean).forEach(par => { %><p><%= par %></p><% }) %>
  <% if (gallery) { %><% if (!gallery.length) { %><p class="muted">Photos coming soon.</p><% } %><div class="gal"><% gallery.forEach(g => { %><figure><img src="/media/<%= g.image_id %>" alt="<%= g.caption || '' %>" loading="lazy"><figcaption><%= g.caption %></figcaption></figure><% }) %></div><% } %>
  <p class="mt"><a href="/products" class="btn btn-outline">Browse products</a></p>
</div>
<%- include('partials/footer') %>
