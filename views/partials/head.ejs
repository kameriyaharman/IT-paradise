<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= desc %>">
<link rel="canonical" href="<%= canonical %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:type" content="website">
<meta name="theme-color" content="#0B1F44">
<% if (s.gsc_verification) { %><meta name="google-site-verification" content="<%= s.gsc_verification %>"><% } %>
<link rel="icon" href="<%= logoUrl %>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<% const gf = [...new Set(['Poppins', theme.font, theme.bodyFont])].map(f => 'family=' + f.replace(/ /g, '+') + ':wght@400;500;600;700;800').join('&'); %>
<link href="https://fonts.googleapis.com/css2?<%= gf %>&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/site.css?v=7">
<% if (s.ga_id) { %><script async src="https://www.googletagmanager.com/gtag/js?id=<%= s.ga_id %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= s.ga_id %>');</script><% } %>
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"LocalBusiness","name":s.company_name||"IT PARADISE","foundingDate":"2006","address":{"@type":"PostalAddress","addressLocality":"Bhilwara","addressRegion":"Rajasthan","addressCountry":"IN","streetAddress":s.address||""},"telephone":s.phone_sales||undefined,"email":s.email||undefined,"url":s.public_url||undefined,"openingHours":"Mo-Sa 10:00-20:00"}) %></script>
<style>:root{--blue:<%= theme.primary %>;--blue2:<%= theme.secondary %>;--navy:<%= theme.navy %>;--ink:<%= theme.navy %>;--hfont:'<%= theme.font %>',Poppins,system-ui,sans-serif;--bfont:'<%= theme.bodyFont %>',Poppins,system-ui,sans-serif;
--g-blue:linear-gradient(120deg,color-mix(in srgb,<%= theme.primary %> 70%,#fff) 0%,<%= theme.primary %> 35%,<%= theme.secondary %> 70%,color-mix(in srgb,<%= theme.primary %> 70%,#fff) 100%);
--g-navy:linear-gradient(120deg,color-mix(in srgb,<%= theme.navy %> 60%,#4a7bd0) 0%,color-mix(in srgb,<%= theme.navy %> 85%,#fff) 45%,<%= theme.navy %> 75%,color-mix(in srgb,<%= theme.navy %> 60%,#4a7bd0) 100%);
--g-ring:linear-gradient(120deg,<%= theme.primary %>,color-mix(in srgb,<%= theme.primary %> 50%,#6C8CFF),<%= theme.secondary %>)}</style>
<% if (s.custom_css) { %><style><%- s.custom_css.replace(/<\/style/gi, '') %></style><% } %>
</head>
<body>
